@startuml
title Flowchart. Вариант 17 (ИБ, ИЗ1, ПЗ2, Д10З1, Д10О4, Д2П1, Д2Б3, ОР1, ОД2)

|Источник|
start
repeat :Сгенерировать заявку;
note right
  ИБ: бесконечный источник
  ИЗ1: пуассоновский поток,
  интервалы распределены экспоненциально
end note

|Диспетчер постановки|
:Принять заявку
(триггер "заявка сгенерирована");

if (Есть свободное место в буфере?) then (нет - буфер переполнен)
  |Буфер|
  :Определить место (УБ-1) mod N
  - заявку, поступившую последней;
  
  |Диспетчер постановки|
  :Вытеснить эту заявку;
  :Зафиксировать отказ
  (вытесненная заявка - в статистику);
  note right
    Д10О4 - Если свободных мест в очереди нет,
    отклоняется последнее поступившее обращение
  end note

  |Буфер|
  :Поставить новую заявку
  на освободившееся место;
  :УБ := следующее за ним место;

else (да - есть свободное место)
  |Буфер|
  repeat
    :Проверить место,
    на которое указывает УБ;
  repeat while (место занято?) (да)
  
  :Поставить заявку на найденное место;
  :УБ := следующее за ним место;
  note right: Д10З1 - поиск по кольцу от УБ
endif

|Диспетчер постановки|
:Зафиксировать событие
"заявка отправлена в буфер";

|Диспетчер выбора|
:Триггер "заявка встала в буфер"
- проверить наличие свободного прибора;

if (Есть свободный прибор?) then (да - HappyFlow)
  |Прибор|
  :Найти первый свободный прибор
  с №1 по кольцу;
  note right
    Д2П1 - ACD перебирает операторов начиная
    с первого номера и назначает обращение
    первому свободному
  end note

  |Буфер|
  repeat
    :Проверить место,
    на которое указывает УВ;
  repeat while (место свободно?) (да)
  
  :Выбрать заявку с этого места;
  :УВ := следующее за ним место;
  note right: Д2Б3 - поиск по кольцу от УВ

  |Диспетчер выбора|
  :Отправить заявку на прибор;
  :Зафиксировать событие
  "заявка отправлена на прибор";

  |Прибор|
  :Обработать заявку;
  note right
    ПЗ2 - время обработки
    распределено равномерно
  end note
  :Зафиксировать событие
  "заявка обработана";
  :Освободиться;

else (нет - все приборы заняты)
  |Диспетчер выбора|
  :Заявка остаётся в буфере;
  :Ожидать событие
  "прибор освободился";
endif

|Прибор|
:Событие "прибор освободился";

|Диспетчер выбора|
:Триггер "прибор освободился"
- проверить буфер;

if (Буфер пуст?) then (да)
  :Прибор простаивает;
  :Ожидать следующее событие;
else (нет - есть заявки)
  |Буфер|
  repeat
    :Проверить место,
    на которое указывает УВ;
  repeat while (место свободно?) (да)
  
  :Выбрать заявку с этого места;
  :УВ := следующее за ним место;
  note right: Д2Б3 - поиск по кольцу от УВ

  |Диспетчер выбора|
  :Отправить заявку
  на освободившийся прибор;
  :Зафиксировать событие
  "заявка отправлена на прибор";

  |Прибор|
  :Обработать заявку;
  note right
    ПЗ2 - время обработки
    распределено равномерно
  end note
  :Зафиксировать событие
  "заявка обработана";
  :Освободиться;
endif

repeat while (Моделирование продолжается?) is (да)
stop

@enduml